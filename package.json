{
  "name": "xtream-player",
  "version": "1.1.1",
  "private": true,
  "description": "Player IPTV desktop compatibile con le API Xtream Codes (Tauri v2)",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.css -o ui/vendor/app.css --minify",
    "build:ui": "npm run vendor && npm run build:css",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "hls.js": "1.6.15",
    "mpegts.js": "1.8.0",
    "tailwindcss": "3.4.17"
  }
}
