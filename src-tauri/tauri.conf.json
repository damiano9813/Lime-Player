{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xtream Player",
  "version": "1.1.1",
  "identifier": "com.xtreamplayer.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": { "script": "npm run fetch:ffmpeg && npm run build:ui", "wait": true },
    "beforeBuildCommand": "npm run fetch:ffmpeg && npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xtream Player",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": { "binaries/ffmpeg-LICENSE.txt": "ffmpeg-LICENSE.txt" },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0NkQ3QjY2NjUxRTI2NzUKUldSMUpoNWxabnR0dEFsMkIrUHlBRFp1dE5nc24zNXFRTjdnM09XM0pUL2Fib2JHVDlTK1h0bzkK",
      "endpoints": ["https://github.com/damiano9813/Lime-Player/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
