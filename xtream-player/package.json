{
  "name": "xtream-player",
  "version": "1.0.0",
  "private": true,
  "description": "Player IPTV desktop compatibile con le API Xtream Codes (Tauri v2)",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.css -o ui/vendor/app.css --minify",
    "build:ui": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "hls.js": "1.6.15",
    "mpegts.js": "1.8.0",
    "tailwindcss": "3.4.17"
  }
}
