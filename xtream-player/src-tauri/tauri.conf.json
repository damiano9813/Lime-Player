{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xtream Player",
  "version": "1.0.0",
  "identifier": "com.xtreamplayer.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": { "script": "npm run build:ui", "wait": true },
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xtream Player",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
